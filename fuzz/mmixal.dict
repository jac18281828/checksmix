# Field-width boundaries, on both sides.
byte_max="#FF"
byte_over="#100"
wyde_max="#FFFF"
wyde_over="#10000"
tetra_max="#FFFFFF"
tetra_over="#1000000"
octa_signed_max="#7FFFFFFFFFFFFFFF"
octa_signed_min="#8000000000000000"
octa_max="#FFFFFFFFFFFFFFFF"

# Register and special-register boundaries.
reg_max="$255"
special_reg_max="31"
special_reg_over="32"

# The harness's skip depth, on both sides.
nesting_max="256"
nesting_over="257"

# The last octabyte-aligned address, where LOC and GREG wrap.
address_top="#FFFFFFFFFFFFFFF8"
